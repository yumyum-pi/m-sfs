{
  "files": {
    "target_dir": "/var/static/assets",
    "temp_dir": "/var/static/tmp",
    "max_file_size": "5MB",
    "supported_files": ["svg", "png", "jpeg", "webp", "gif", "pdf"]
  },
  "jwt": {
    "signing_method": "HS256",
    "secret": "change-me",
    "issuer": "example-auth",
    "audience": "asset-manager"
  },
  "database": {
    "driver": "sqlite",
    "path": "./data/dev.db"
  },
  "logging": {
    "level": "INFO"
  }
}
